# Optional local catalogue path. Defaults to ./steam_games_reviews_25.sqlite
RAGLOOKER_DB_PATH=steam_games_reviews_25.sqlite
RAGLOOKER_LLM_ENABLED=1
RAGLOOKER_LLM_PROVIDER=ollama

# Used when RAGLOOKER_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
RAGLOOKER_DEEPSEEK_MODEL=deepseek-v4-flash

# Optional pre-exported ONNX Cross-encoder directory
RAGLOOKER_RERANKER_MODEL_DIR=
